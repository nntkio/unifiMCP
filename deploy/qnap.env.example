# Copy to qnap.env on the NAS and fill in real values. Never commit qnap.env.

# --- UniFi controller ---
UNIFI_HOST=https://172.16.25.1
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false
UNIFI_IS_UNIFI_OS=true

# --- MCP server: HTTP transport (required for a network deployment) ---
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765
TOKEN_DB_PATH=/data/tokens.db

# --- Token-admin service ---
# Root exists only to create accounts; it can never own a bearer token.
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SESSION_SECRET=
ADMIN_HTTP_HOST=0.0.0.0
ADMIN_HTTP_PORT=8766
