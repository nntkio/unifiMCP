# UniFi Controller Configuration
# Copy this file to .env and fill in your values

# UniFi Controller URL (required)
# Standard controller: https://192.168.1.1:8443
# UniFi OS (UDM/UDM Pro): https://192.168.1.1
UNIFI_HOST=https://192.168.1.1

# UniFi Controller credentials (required)
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your-password-here

# UniFi site name (optional, defaults to "default")
UNIFI_SITE=default

# Verify SSL certificates (optional, defaults to "true")
# Set to "false" for self-signed certificates
UNIFI_VERIFY_SSL=false

# UniFi OS device (optional, defaults to "false")
# Set to "true" for UDM, UDM Pro, UCG Max, etc.
UNIFI_IS_UNIFI_OS=false

# --- MCP transport ---

# MCP_TRANSPORT selects how the server talks to its MCP client:
#
#   http   A persistent Streamable HTTP service listening on
#          MCP_HTTP_HOST:MCP_HTTP_PORT, protected by bearer tokens created in
#          the token-admin service (unifi-mcp-admin). This is the mode the
#          docker-compose.yml stack needs: the unifi-mcp container has no
#          stdin, so a stdio server inside it can never be reached and the
#          health check on port 8765 never passes.
#
#   stdio  MCP over stdin/stdout. Use this when the MCP client launches
#          unifi-mcp itself as a subprocess, for example via `docker run -i`
#          or scripts/run-mcp.sh. The MCP_HTTP_* and TOKEN_DB_PATH settings
#          below are ignored.
#
# When the variable is unset the server defaults to stdio. This file sets
# http because docker compose is its main consumer. scripts/run-mcp.sh also
# reads this file but always forces stdio, so a client-launched server keeps
# working with the same .env.
MCP_TRANSPORT=http

# HTTP transport bind host/port (only used when MCP_TRANSPORT=http).
# Keep the host at 0.0.0.0 inside a container; a LAN address only works
# with host networking.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765

# Path to the SQLite token database, shared with the token-admin service
# through the unifi-mcp-data volume (only used when MCP_TRANSPORT=http)
TOKEN_DB_PATH=/data/tokens.db

# --- Token-admin service (unifi-mcp-admin) ---

# Root admin identity: env-var only, no database row, so root can never own
# a bearer token. Used to log in to the admin UI and create accounts for
# other people, who then create/manage their own tokens.
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_PASSWORD=change-me-to-a-strong-password

# Signs the admin service's session cookies (generate with, e.g.,
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`)
ADMIN_SESSION_SECRET=

ADMIN_HTTP_HOST=0.0.0.0
ADMIN_HTTP_PORT=8766
